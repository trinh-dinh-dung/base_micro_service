{
  "Auth": {
    "Authority": "http://localhost:5010"
  },
  "ServiceDiscovery": {
    "UseConsul": false,
    "ConsulAddress": "http://localhost:8500"
  },
  "ReverseProxy": {
    "Routes": {
      "service-base-route": {
        "ClusterId": "service-base",
        "Match": {
          "Path": "/api/base/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/base" }
        ]
      },
      "service-upload-route": {
        "ClusterId": "service-upload",
        "Match": {
          "Path": "/api/upload/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/upload" }
        ]
      },
      "auth-route": {
        "ClusterId": "auth-server",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ],
        "AuthorizationPolicy": "Anonymous"
      }
    },
    "Clusters": {
      "service-base": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5000"
          }
        }
      },
      "service-upload": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "auth-server": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5010"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
