<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Auth Server</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .login-container { width: 100%; max-width: 420px; }
        .login-card {
            background: #fff;
            border-radius: 16px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        }
        .login-header { text-align: center; margin-bottom: 32px; }
        .logo { font-size: 48px; margin-bottom: 12px; }
        .login-header h1 { font-size: 28px; color: #1a1a2e; font-weight: 700; }
        .login-header p { color: #666; margin-top: 8px; }
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; font-size: 14px; font-weight: 600; color: #333; margin-bottom: 8px; }
        .form-input {
            width: 100%; padding: 12px 16px; border: 2px solid #e1e5ee;
            border-radius: 8px; font-size: 15px; transition: border-color 0.2s;
            outline: none;
        }
        .form-input:focus { border-color: #667eea; }
        .btn-login {
            width: 100%; padding: 13px; background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff; border: none; border-radius: 8px; font-size: 16px;
            font-weight: 600; cursor: pointer; margin-top: 8px; transition: opacity 0.2s;
        }
        .btn-login:hover { opacity: 0.9; }
        .error-msg { background: #fee; border: 1px solid #fcc; border-radius: 8px; padding: 12px; margin-bottom: 16px; color: #c33; font-size: 14px; }
        .field-error { color: #e53; font-size: 12px; margin-top: 4px; display: block; }
        .demo-credentials { margin-top: 24px; padding: 12px; background: #f8f9ff; border-radius: 8px; text-align: center; font-size: 13px; color: #666; }
        .demo-credentials strong { color: #333; }
    </style>
</head>
<body>
    @RenderBody()
</body>
</html>
