# Copy file này thành .env và điền giá trị thực
# cp .env.example .env

# ── SQL Server (Service Base) ─────────────────────────────
SERVICE_BASE_DB=Server=192.168.252.158,1433;Database=PIAS_AUDIT_LOGS;User Id=sa;Password=s@123456;TrustServerCertificate=True;

# ── PostgreSQL (Service Upload) ───────────────────────────
SERVICE_UPLOAD_DB=Server=localhost;Port=5432;Database=ManageDepartment;User Id=postgres;Password=yourpassword;

# ── Elasticsearch (optional) ──────────────────────────────
ELASTIC_URI=http://localhost:9200

# ── IAM validation API (backend verify access token) ──────
IAM_VALIDATE_URL=https://auth.pvi.com.vn/api/Authentication/ValidAccessToken

# ── IAM / SSO signing (Gateway giữ private key) ───────────
VITE_API_TOKEN_URL=https://authtest.pvi.com.vn
VITE_CALLBACK_URL=http://localhost:5173/login-callback
VITE_APP_ID=your-app-id
SSO_PRIVATE_KEY=your-rsa-private-key-base64
